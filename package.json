{
  "name": "sagasu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --cwd apps/web run dev",
    "dev:web": "bun --cwd apps/web run dev",
    "dev:api": "bun --cwd apps/api run dev",
    "test:api": "bun test --cwd apps/api",
    "build": "bun --cwd apps/web run build",
    "check": "bun --cwd apps/web run check"
  },
  "devDependencies": {
    "puppeteer-core": "^25.9.0"
  }
}
